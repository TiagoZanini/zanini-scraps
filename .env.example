# ─── COPIA ESTE ARQUIVO PARA .env E PREENCHA ───────────────────────────────
# Railway/Render: adicione estas variáveis no painel de ambiente (não o arquivo)

# Segurança — TROQUE por uma string longa e aleatória
SECRET_KEY=coloque-aqui-uma-chave-secreta-longa-e-unica

# Banco de dados — Railway preenche automaticamente ao adicionar PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Admin inicial (usado apenas no init_db.py)
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=TroqueEssaSenha2026!
ADMIN_NAME=Zanini Admin

# Mercado Pago — pegue em: mercadopago.com.br/developers > Suas integrações > Credenciais
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_WEBHOOK_URL=https://seudominio.com.br/mp-webhook
MP_WEBHOOK_SECRET=sua_chave_secreta_do_webhook_mp

# E-mail (Gmail com senha de app)
MAIL_USERNAME=seu@gmail.com
MAIL_PASSWORD=sua_senha_de_app_aqui
MAIL_DEFAULT_SENDER=noreply@seudominio.com.br
